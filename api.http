@baseUrl = http://localhost:8080/api/v1

### 0. Preparar datas (daqui a 10 e 20 dias, horário local) — só lista eventos (200)
< {%
  const pad = (n) => String(n).padStart(2, "0");
  const plusDays = (days, hour) => {
    const d = new Date();
    d.setDate(d.getDate() + days);
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(hour)}:00:00`;
  };
  client.global.set("data10", plusDays(10, 19));
  client.global.set("data20", plusDays(20, 9));
  client.global.set("suffix", String(Date.now()));
%}
GET {{baseUrl}}/eventos

### CT01 + CT02 — cadastrar evento válido, estado "pb" gravado como "PB" (201)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nome": "Workshop Spring Boot {{suffix}}",
  "dataHoraEvento": "{{data10}}",
  "local": "Auditório Central",
  "cidade": "João Pessoa",
  "estado": "pb",
  "qtde": 50
}

> {%
  client.assert(response.status === 201, "evento não criado");
  client.assert(response.body.id, "id não gerado");
  client.assert(response.body.estado === "PB", "estado não foi gravado em maiúsculas");
  client.global.set("eventoId", response.body.id);
  client.global.set("eventoNome", response.body.nome);
%}

### Cadastrar segundo evento, outra cidade/estado (201)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nome": "Meetup Angular {{suffix}}",
  "dataHoraEvento": "{{data20}}",
  "local": "Centro de Convenções",
  "cidade": "Recife",
  "estado": "PE",
  "qtde": 30
}

> {%
  client.assert(response.status === 201, "evento não criado");
  client.global.set("outroEventoId", response.body.id);
%}

### CT03a — sem nome (400 padrão do Spring)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "dataHoraEvento": "{{data10}}",
  "local": "Auditório",
  "cidade": "João Pessoa",
  "estado": "PB",
  "qtde": 10
}

> {% client.assert(response.status === 400, "esperado 400"); %}

### CT03b — qtde = 0 (400 padrão do Spring)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nome": "Evento sem vagas",
  "dataHoraEvento": "{{data10}}",
  "local": "Auditório",
  "cidade": "João Pessoa",
  "estado": "PB",
  "qtde": 0
}

> {% client.assert(response.status === 400, "esperado 400"); %}

### CT04 — data no passado (400)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nome": "Evento no passado",
  "dataHoraEvento": "2020-01-01T10:00:00",
  "local": "Auditório",
  "cidade": "João Pessoa",
